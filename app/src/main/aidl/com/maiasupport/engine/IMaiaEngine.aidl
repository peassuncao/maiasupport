package com.maiasupport.engine;

import com.maiasupport.engine.IMaiaResultCallback;

/** Bound-service API for third-party chess apps. */
interface IMaiaEngine {
    int getApiVersion();
    boolean isModelReady();
    String getEngineName();

    /**
     * Request the highest-probability legal move. legalMoves must contain UCI
     * moves generated by the calling chess app for the supplied FEN.
     * Callback returns (requestId, bestMoveUci, errorMessage); exactly one of
     * bestMoveUci/errorMessage is non-null on completion.
     */
    void requestBestMove(String requestId, String fen, int selfElo, int opponentElo,
                         in String[] legalMoves, IMaiaResultCallback callback);
}
